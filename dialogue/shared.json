    {
      "id": "shared_feelings_check",
      "trigger": "idle",
      "start": "a",
      "nodes": {
        "a": {
          "say": "My day was full of little things. Was yours a sunny one?",
          "expr": "curious",
          "choices": [
            {
              "icon": "😊",
              "label": "Good!",
              "goto": "good",
              "reply": "Good days are the best kind. Yay!",
              "expr": "happy",
              "gesture": "pounce"
            },
            {
              "icon": "😐",
              "label": "Okay",
              "goto": "okay",
              "reply": "Okay days are allowed. They're like plain toast. Still toast."
            },
            {
              "icon": "😢",
              "label": "Not great",
              "goto": "hard",
              "reply": "Then I'll sit right here with you. You don't have to say anything.",
              "expr": "sad"
            },
            {
              "icon": "🤫",
              "label": "Just sit",
              "goto": "sit",
              "reply": "",
              "expr": "love",
              "gesture": "settle"
            }
          ]
        },
        "good": {
          "say": "Sunny days are good for playing. Want to play something?",
          "expr": "happy",
          "choices": [
